set_option maxRecDepth 65536 in
set_option maxHeartbeats 20000000 in
-- The closed 704-step recurrence needs a longer kernel reduction.
set_option exponentiation.threshold 4096 in
set_option Elab.async false in
private theorem packedRun_704_eq_checkpointPack :
    packedRun 704 (scale * radix ^ 384) = checkpointPack := by
  rfl

set_option maxRecDepth 65536 in
set_option maxHeartbeats 20000000 in
-- The closed extraction multiplies two 100,000-bit natural numbers.
set_option exponentiation.threshold 4096 in
set_option Elab.async false in
private theorem checkpointPack_values :
    ((((checkpointPack * extraPack * reversedWeightPack) >>> (145 * 774)) % radix),
      scale - checkpointPack % (radix - 1)) =
      (182190504909736707587867345424, 4538522943514) := by
  decide +kernel

/-- The kernel-checked values extracted from the 704-step recurrence. -/
theorem certificateValues_eq :
    let x := packedRun 704 (scale * radix ^ 384)
    ((((x * extraPack * reversedWeightPack) >>> (145 * 774)) % radix),
      scale - x % (radix - 1)) =
      (182190504909736707587867345424, 4538522943514) := by
  rw [packedRun_704_eq_checkpointPack]
  exact checkpointPack_values

end lweCKA.ChallengeCertificateArithmetic
