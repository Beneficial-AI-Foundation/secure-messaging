module

public import Mathlib.Data.Nat.Bitwise

/-!
# Exact arithmetic for the Frodo Challenge certificate

This internal module checks the closed 704-step packed recurrence used by the
challenge certificate. The checkpoint is encoded as 256-bit limbs so every
source line remains short, while the kernel checks both its reconstruction and
the final extracted values.
-/

@[expose] public section

namespace lweCKA.ChallengeCertificateArithmetic

/-- The fixed-point scale used for the packed recurrence. -/
def scale : Nat := 2 ^ 128

/-- The radix that separates adjacent packed coefficients. -/
def radix : Nat := 2 ^ 145

/-- A packed sequence of 769 unit coefficients. -/
def repunit : Nat :=
  (List.range 769).foldl (fun acc _ => acc * radix + 1) 0

/-- The mask that rounds and retains every packed coefficient. -/
def roundingMask : Nat := (2 ^ 129 - 1) * repunit

/-- The packed one-step product distribution. -/
def productPack : Nat :=
  18 + 240 * radix ^ 3 + 800 * radix ^ 5 + 732 * radix ^ 6 +
  4880 * radix ^ 7 + 7442 * radix ^ 8 + 37312 * radix ^ 9 +
  7442 * radix ^ 10 + 4880 * radix ^ 11 + 732 * radix ^ 12 +
  800 * radix ^ 13 + 240 * radix ^ 15 + 18 * radix ^ 18

/-- One step of the exact packed recurrence. -/
def packedStep (x : Nat) : Nat :=
  ((x * productPack) >>> (9 * 145 + 16)) &&& roundingMask

/-- Tail-recursive iteration of a natural-number step function. -/
def packedIterate (step : Nat → Nat) : Nat → Nat → Nat
  | 0, x => x
  | n + 1, x => packedIterate step n (step x)

/-- The packed recurrence iterated from `x` for `n` steps. -/
def packedRun (n x : Nat) : Nat :=
  packedIterate packedStep n x

/-- The packed seven-coefficient correction distribution. -/
def extraPack : Nat :=
  3 + 20 * radix + 61 * radix ^ 2 + 88 * radix ^ 3 +
  61 * radix ^ 4 + 20 * radix ^ 5 + 3 * radix ^ 6

/-- The reversed packed weights for the certificate dot product. -/
def reversedWeightPack : Nat :=
  (List.range 775).foldl
    (fun acc i => acc * radix +
      ((if i ≤ 387 then 387 - i else i - 387) - 256)) 0

private def fromLimbs256 (limbs : List Nat) : Nat :=
  limbs.foldl (fun acc limb => (acc <<< 256) + limb) 0

