import VersoManual
import VersoManual.Diagrams

/-! # SCKA figures

SVG figures generated by `scripts/tikz-to-verso-svg.py` from the TikZ sources
in `docs/SecureMessagingDocs/Visuals/tikz`, stored in `figures/` next to this file.
Edit the sources and regenerate the figures and this file instead of editing them.
-/

open Verso Genre Manual Doc Elab
open Lean

/-- SVG of `scka-overview.tex` (SHA-256 prefix `6aae35011f97a54a`). -/
private def sckaOverviewFigureSvg : String := include_str "figures/scka-overview.svg"

/-- Embed `scka-overview.tex` with Verso's SVG renderer. -/
@[directive]
def sckaOverviewFigure : DirectiveExpanderOf Unit
  | (), _ =>
    ``(Block.other
      (Block.diagram $(quote sckaOverviewFigureSvg) "100%" "\\textwidth" false) #[])
