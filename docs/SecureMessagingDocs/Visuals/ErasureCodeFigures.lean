import VersoManual
import VersoManual.Diagrams

/-! # Erasure code figures

SVG figures generated by `scripts/tikz-to-verso-svg.py` from the TikZ sources
in `docs/SecureMessagingDocs/Visuals/tikz`, stored in `figures/` next to this file.
Edit the sources instead of the figures or this file, and regenerate both from the
repository root:

```
scripts/tikz-to-verso-svg.py docs/SecureMessagingDocs/Visuals/ErasureCodeFigures.lean \
  docs/SecureMessagingDocs/Visuals/tikz/ec-instances.tex \
  docs/SecureMessagingDocs/Visuals/tikz/ec-scheme.tex \
  docs/SecureMessagingDocs/Visuals/tikz/ec-streaming.tex \
  docs/SecureMessagingDocs/Visuals/tikz/ec-reed-solomon.tex \
  docs/SecureMessagingDocs/Visuals/tikz/ec-parallel.tex
```
-/

open Verso Genre Manual Doc Elab
open Lean

/-- SVG of `ec-instances.tex` (SHA-256 prefix `56674ddf6ffd0ebf`). -/
private def erasureCodeInstancesFigureSvg : String := include_str "figures/ec-instances.svg"

/-- Embed `ec-instances.tex` with Verso's SVG renderer. -/
@[directive]
def erasureCodeInstancesFigure : DirectiveExpanderOf Unit
  | (), _ =>
    ``(Block.other
      (Block.diagram $(quote erasureCodeInstancesFigureSvg) "100%" "\\textwidth" false) #[])

