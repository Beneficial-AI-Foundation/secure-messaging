/-
  SimpleAuth in DYLean: protocol specification.

  This is a port of LeanDY's SimpleAuth example
  (`symbolicTools/leandy-examples/LeanDYExamples/SimpleAuth.lean`;
  `Protocols/SimpleAuth.lean` in the LeanDY repository):

      A → B :  A ⋅ B ⋅ Na
      B → A :  ⟨ Na ⋅ A ⟩_(SK A B)

  The initiator A logs `Start A B Na` when it sends the first message,
  and `Done A B Na` once it has decrypted and checked the response.

  The file is organised like DYLean's `Examples/SignedDH/Specification.lean`:
  1. the cryptographic primitives available to the protocol (`HasExecBytes`),
  2. the messages, states and events,
  3. the wire formats of messages and states (Comparse),
  4. the kinds of entries that may appear in the trace (`HasExecTrace`),
  5. the protocol code itself (one `Traceful` function per protocol step),
  6. security predicates mentioned in the security theorems,
  7. the reachability configuration: which functions the attacker may call.

  Main differences with LeanDY, discussed in more detail in the tutorial:
  - in LeanDY a protocol step is a pure `exchange` (time, input, state) ↦ (message, state, events),
    wrapped by a generic `transition`;
    in DYLean a protocol step is an arbitrary program in the `Traceful` monad
    that receives/sends messages, loads/stores states and logs events itself;
  - LeanDY names the shared key `Sk a b` and assigns it a label in a global environment `Γ`;
    DYLean has no global names: keys are random values generated by a setup step,
    their label and usage are attached at generation time,
    and each participant keeps the key in its own (compromisable) state.
-/

module

public import DY.Trace
public import DY.Bytes
public import DY.EquationalTheory.Literal
public import DY.EquationalTheory.Concat
public import DY.Actions.Network
public import DY.Actions.Random
public import DY.Actions.ProtocolEvent
public import DY.Actions.PersistentLocalState
public import DY.Comparse
public import DYLeanExamples.SimpleAuth.SymEnc

namespace DY.Example.SimpleAuth

open DY.Comparse

/-
  Which symbolic constructors (and attacker capabilities) exist.
  LeanDY fixes one symbolic algebra for all protocols;
  in DYLean each protocol picks the equational theories it needs.
  SimpleAuth needs random values (nonces and keys), literals and concatenation
  (to serialize messages) and symmetric encryption.
-/
-- Future work (upstream comment): the following section is boilerplate that could be meta-programmed
public section ExecBytesConfig

class HasExecBytes where
  [bytesFunc: BytesFunctor]
  [bytesFunc0: BytesFunctor.Has Random.SubF]
  [bytesFunc1: BytesFunctor.Has Literal.SubF]
  [bytesFunc2: BytesFunctor.Has Concat.SubF]
  [bytesFunc3: BytesFunctor.Has SymEnc.SubF]
  [bytesLen: BytesLength]
  [bytesLen0: BytesLength.Has Random.SubF.length]
  [bytesLen1: BytesLength.Has Literal.SubF.length]
  [bytesLen2: BytesLength.Has Concat.SubF.length]
  [bytesLen3: BytesLength.Has SymEnc.SubF.length]
  [att: AttackerKnowledge]
  [att0: AttackerKnowledge.Has Random.attackerKnowledge]
  [att1: AttackerKnowledge.Has Literal.attackerKnowledge]
  [att2: AttackerKnowledge.Has Concat.attackerKnowledge]
  [att3: AttackerKnowledge.Has SymEnc.attackerKnowledge]

attribute [reducible, scoped instance] HasExecBytes.bytesFunc
attribute [reducible, scoped instance] HasExecBytes.bytesFunc0
attribute [reducible, scoped instance] HasExecBytes.bytesFunc1
attribute [reducible, scoped instance] HasExecBytes.bytesFunc2
attribute [reducible, scoped instance] HasExecBytes.bytesFunc3
attribute [reducible, scoped instance] HasExecBytes.bytesLen
attribute [           scoped instance] HasExecBytes.bytesLen0
attribute [           scoped instance] HasExecBytes.bytesLen1
attribute [           scoped instance] HasExecBytes.bytesLen2
attribute [           scoped instance] HasExecBytes.bytesLen3
attribute [reducible, scoped instance] HasExecBytes.att
attribute [           scoped instance] HasExecBytes.att0
attribute [           scoped instance] HasExecBytes.att1
attribute [           scoped instance] HasExecBytes.att2
attribute [           scoped instance] HasExecBytes.att3

end ExecBytesConfig

public section Structures

variable [HasExecBytes]

/-- First message, A → B : A ⋅ B ⋅ Na. -/
structure InitMessage where
  a: Participant
  b: Participant
  na: Bytes

/--
  Plaintext of the second message, B → A : ⟨ Na ⋅ A ⟩_(SK A B).
  The field order (nonce first, identity second) is the one used by both
  the responder (encryption) and the initiator (decryption):
  since both sides use the same Comparse format, they cannot disagree on it.
-/
structure ResponsePayload where
  na: Bytes
  a: Participant

/--
  The pre-shared symmetric key SK(A,B) between an initiator and a responder,
  stored by both of them.
  As in LeanDY, the key is indexed by the *ordered* pair (initiator, responder).
-/
structure SharedKeyState where
  initiator: Participant
  responder: Participant
  key: Bytes

/--
  The initiator's session state, LeanDY's `State.Init a b na`.
  The owner `a` is not stored: every DYLean local state is tagged with its owner.
  There is no counterpart of LeanDY's `State.Null`:
  DYLean has no "current state" that a step must always overwrite.
-/
structure InitiatorState where
  b: Participant
  na: Bytes

/--
  Protocol events, LeanDY's `Event.start` and `Event.done`.
  LeanDY events are a string tag plus untyped content;
  DYLean events are an ordinary (typed) inductive type.
-/
inductive SimpleAuthEvent where
  | Start (a b: Participant) (na: Bytes)
  | Done (a b: Participant) (na: Bytes)
deriving DecidableEq

end Structures

/-
  Wire formats, using the Comparse library.
  `.slowString` / `.slowBytes` are length-prefixed (they can be followed by more fields),
  `.string` / `.bytes` consume the rest of the input (last field only).
  Each format comes with an `IsWellFormed_eq` lemma that says
  "a predicate holds on the serialized value iff it holds on its `Bytes` fields"
  (participant names are literals: they are always public and well-formed).
-/
-- Future work (upstream comment): the following section is boilerplate that could be meta-programmed
public section Formats

variable [HasExecBytes]

public
instance: ParseableSerializeable InitMessage := .make <|
  .triviallyIsomorphic
    (.prod .slowString (.prod .slowString .bytes))
    (fun ⟨ a, b, na ⟩ => { a, b, na })
    (fun { a, b, na } => ⟨ a, b, na ⟩)

public
theorem InitMessage.IsWellFormed_eq
  (pre: Bytes → τ → Prop) [BytesCompatibleTracePred pre] (x: InitMessage) (tr: τ):
  IsWellFormed pre x tr = pre x.na tr
:= by
  simp [Comparse.IsWellFormed, Comparse.ParseableSerializeable.mf]

grind_pattern InitMessage.IsWellFormed_eq => IsWellFormed pre x tr
grind_pattern [grind_later] InitMessage.IsWellFormed_eq => IsWellFormed pre x tr

public
instance: ParseableSerializeable ResponsePayload := .make <|
  .triviallyIsomorphic
    (.prod .slowBytes .string)
    (fun ⟨ na, a ⟩ => { na, a })
    (fun { na, a } => ⟨ na, a ⟩)

public
theorem ResponsePayload.IsWellFormed_eq
  (pre: Bytes → τ → Prop) [BytesCompatibleTracePred pre] (x: ResponsePayload) (tr: τ):
  IsWellFormed pre x tr = pre x.na tr
:= by
  simp [Comparse.IsWellFormed, Comparse.ParseableSerializeable.mf]

grind_pattern ResponsePayload.IsWellFormed_eq => IsWellFormed pre x tr
grind_pattern [grind_later] ResponsePayload.IsWellFormed_eq => IsWellFormed pre x tr

public
instance: ParseableSerializeable SharedKeyState := .make <|
  .triviallyIsomorphic
    (.prod .slowString (.prod .slowString .bytes))
    (fun ⟨ initiator, responder, key ⟩ => { initiator, responder, key })
    (fun { initiator, responder, key } => ⟨ initiator, responder, key ⟩)

public
theorem SharedKeyState.IsWellFormed_eq
  (pre: Bytes → τ → Prop) [BytesCompatibleTracePred pre] (x: SharedKeyState) (tr: τ):
  IsWellFormed pre x tr = pre x.key tr
:= by
  simp [Comparse.IsWellFormed, Comparse.ParseableSerializeable.mf]

grind_pattern SharedKeyState.IsWellFormed_eq => IsWellFormed pre x tr

public
instance: ParseableSerializeable InitiatorState := .make <|
  .triviallyIsomorphic
    (.prod .slowString .bytes)
    (fun ⟨ b, na ⟩ => { b, na })
    (fun { b, na } => ⟨ b, na ⟩)

public
theorem InitiatorState.IsWellFormed_eq
  (pre: Bytes → τ → Prop) [BytesCompatibleTracePred pre] (x: InitiatorState) (tr: τ):
  IsWellFormed pre x tr = pre x.na tr
:= by
  simp [Comparse.IsWellFormed, Comparse.ParseableSerializeable.mf]

grind_pattern InitiatorState.IsWellFormed_eq => IsWellFormed pre x tr

end Formats

/-
  Which kinds of entries the trace may contain:
  network messages, random generations, protocol events,
  and (compromisable) local states of the two state types.
  In LeanDY, the trace entry type is fixed by the library;
  in DYLean, it is assembled per protocol.
-/
-- Future work (upstream comment): the following section is boilerplate that could be meta-programmed
public section ExecTraceConfig

class HasExecTrace extends HasExecBytes where
  [traceExec: ExecTraceTypes]
  [traceExec0: ExecTraceTypes.Has Network.ExecEntryT]
  [traceExec1: ExecTraceTypes.Has Random.ExecEntryT]
  [traceExec2: ExecTraceTypes.Has (ProtocolEvent.ExecEntryT SimpleAuth.SimpleAuthEvent)]
  [traceExec3: ExecTraceTypes.Has (PersistentLocalState.CompromisableState.ExecEntryT SimpleAuth.SharedKeyState)]
  [traceExec4: ExecTraceTypes.Has (PersistentLocalState.CompromisableState.ExecEntryT SimpleAuth.InitiatorState)]
  [attBase: BaseAttackerKnowledge]

attribute [reducible, scoped instance] HasExecTrace.traceExec
attribute [reducible, scoped instance] HasExecTrace.traceExec0
attribute [reducible, scoped instance] HasExecTrace.traceExec1
attribute [reducible, scoped instance] HasExecTrace.traceExec2
attribute [reducible, scoped instance] HasExecTrace.traceExec3
attribute [reducible, scoped instance] HasExecTrace.traceExec4
attribute [reducible, scoped instance] HasExecTrace.attBase

end ExecTraceConfig

public section Specification

variable [HasExecTrace]

/--
  Setup: generate a fresh symmetric key SK(initiator, responder)
  and give a copy to each of the two participants.
  This replaces LeanDY's named key `sk a b := key (nonce (Nonce.Sk a b))`.
  Returns the state handles of the initiator's and responder's copies.
-/
def SharedKey.generate (initiator responder: Participant): Traceful (Nat × Nat) := do
  let key ← Random.genRand 32
  let initiatorHandle ← PersistentLocalState.storeLocalState initiator ({ initiator, responder, key }: SharedKeyState)
  let responderHandle ← PersistentLocalState.storeLocalState responder ({ initiator, responder, key }: SharedKeyState)
  return (initiatorHandle, responderHandle)

/--
  A → B : A ⋅ B ⋅ Na  (LeanDY's `initiator a b na`).
  The nonce is freshly generated instead of being passed as an argument:
  DYLean random values are trace entries, hence fresh by construction.
  The event is logged *before* the state is stored, because the state invariant mentions it.
  Returns the handles of the stored state and of the sent message.
-/
def Initiator.start (a b: Participant): Traceful (Nat × Nat) := do
  let na ← Random.genRand 32
  ProtocolEvent.logEvent (SimpleAuthEvent.Start a b na)
  let stHandle ← PersistentLocalState.storeLocalState a ({ b, na }: InitiatorState)
  let msgHandle ← Network.sendMessage (serialize ({ a, b, na }: InitMessage))
  return (stHandle, msgHandle)

/--
  B → A : ⟨ Na ⋅ A ⟩_(SK A B)  (LeanDY's `responder a b`).
  The responder `b` reads the first message, checks the identities it contains,
  loads its copy of the shared key with `a`, and replies with an encryption of (Na, A).
  As in LeanDY, the responder keeps no session state and logs no event.
  `guard c` aborts the step when `c` is false: nothing more is appended to the trace.
-/
def Responder.respond (a b: Participant) (keyHandle msgHandle: Nat): Traceful Nat := do
  let msgBytes ← Network.receiveMessage msgHandle
  let msg: InitMessage ← parse msgBytes
  guard (msg.a = a ∧ msg.b = b)
  let keySt: SharedKeyState ← PersistentLocalState.getLocalState b keyHandle
  guard (keySt.initiator = a ∧ keySt.responder = b)
  let cipher := SymEnc.symEnc keySt.key (serialize ({ na := msg.na, a := msg.a }: ResponsePayload))
  Network.sendMessage cipher

/--
  A: decrypt the response and check it against the stored session state
  (LeanDY's `initiator_check`).
  The key is the initiator's copy of SK(a, b), where `b` comes from the session state.
  On success, `Done a b na` is logged.
-/
def Initiator.finish (a: Participant) (keyHandle stHandle msgHandle: Nat): Traceful Unit := do
  let ({ b, na }: InitiatorState) ← PersistentLocalState.getLocalState a stHandle
  let keySt: SharedKeyState ← PersistentLocalState.getLocalState a keyHandle
  guard (keySt.initiator = a ∧ keySt.responder = b)
  let cipher ← Network.receiveMessage msgHandle
  let plaintext ← SymEnc.symDec keySt.key cipher
  let payload: ResponsePayload ← parse plaintext
  guard (payload.na = na ∧ payload.a = a)
  ProtocolEvent.logEvent (SimpleAuthEvent.Done a b na)

/-
  State compromise: the attacker may leak any stored state to the network.
  LeanDY's SimpleAuth has no compromise (its keys are labelled `𝓢ec` forever);
  DYLean protocols conventionally include it.
-/

def SharedKeyState.compromise (stHandle: Nat): Traceful Nat := do
  PersistentLocalState.compromise SharedKeyState stHandle

def InitiatorState.compromise (stHandle: Nat): Traceful Nat := do
  PersistentLocalState.compromise InitiatorState stHandle

end Specification

public section SecurityPredicates

variable [HasExecTrace]

/--
  The shared key SK(initiator, responder) = `key` has leaked:
  one of the two participants' copies has been compromised.
  It is used to define the key's label in `Proof.lean`.
-/
def SharedKeyCompromised
  (initiator responder: Participant) (key: Bytes)
  (tr: ExecTrace)
  : Prop
:=
  PersistentLocalState.LocalStateCompromised initiator ({ initiator, responder, key }: SharedKeyState) tr ∨
  PersistentLocalState.LocalStateCompromised responder ({ initiator, responder, key }: SharedKeyState) tr

theorem SharedKeyCompromised_le
  (initiator responder: Participant) (key: Bytes)
  (tr1 tr2: ExecTrace)
  : tr1 ≤ tr2 →
    SharedKeyCompromised initiator responder key tr1 →
    SharedKeyCompromised initiator responder key tr2
:= by
  simp only [SharedKeyCompromised]
  grind

grind_pattern SharedKeyCompromised_le => tr1 ≤ tr2, SharedKeyCompromised initiator responder key tr1

end SecurityPredicates

/-
  Reachability: the set of traces we prove things about.
  A trace is reachable if it is obtained from the empty trace by any sequence of calls
  to the functions combined below, with arguments chosen by the attacker.
  `Network` lets the attacker send any message it can derive.
  This is DYLean's counterpart of LeanDY's `valid_trace` / `transition`:
  LeanDY reasons about all traces satisfying the invariant,
  DYLean reasons about all traces that the attacker can actually produce.
-/
public section Reachability

variable [HasExecTrace]

-- Future work (upstream comment): the following section is boilerplate that could be meta-programmed
@[expose] public section
def SharedKey.generate.reachability: ReachabilityConfig := .make (fun (initiator, responder) => SharedKey.generate initiator responder)
def Initiator.start.reachability: ReachabilityConfig := .make (fun (a, b) => Initiator.start a b)
def Responder.respond.reachability: ReachabilityConfig := .make (fun (a, b, keyHandle, msgHandle) => Responder.respond a b keyHandle msgHandle)
def Initiator.finish.reachability: ReachabilityConfig := .make (fun (a, keyHandle, stHandle, msgHandle) => Initiator.finish a keyHandle stHandle msgHandle)
def SharedKeyState.compromise.reachability: ReachabilityConfig := .make (fun stHandle => SharedKeyState.compromise stHandle)
def InitiatorState.compromise.reachability: ReachabilityConfig := .make (fun stHandle => InitiatorState.compromise stHandle)
end

#combine into ReachabilityConfig from
  Network,
  SharedKey.generate,
  Initiator.start,
  Responder.respond,
  Initiator.finish,
  SharedKeyState.compromise,
  InitiatorState.compromise,

end Reachability

end DY.Example.SimpleAuth
